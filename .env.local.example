# ─────────────────────────────────────────────────────────────
# ThermaMorph — Environment Variables
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local to git — it is excluded via .gitignore.
# ─────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────
# Find in: Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — only used server-side, never expose to browser
# Find in: Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App URL (for OAuth redirects) ────────────────────────────
# Local dev: http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Hugging Face (optional — free vision AI) ─────────────────
# Free account: https://huggingface.co -> Settings -> Access Tokens
# Used for AI photo analysis (BLIP captioning). If omitted, the
# app falls back to rule-based analysis only.
HF_API_TOKEN=hf_your_token_here
